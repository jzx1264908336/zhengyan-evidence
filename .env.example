# Optional server-side model configuration. Never expose through NEXT_PUBLIC_*.
# Without these, the app is a clearly labelled verified-filing/rule-based edition.
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.openai.com/v1/responses
MODEL_NAME=gpt-5.4-mini

# Optional Fuyao REST financial cross-check. Server-only; distinct from model API key.
HITHINK_FINANCE_API_KEY=
# iFinD is not integrated. Do not use its token as a Fuyao key.
